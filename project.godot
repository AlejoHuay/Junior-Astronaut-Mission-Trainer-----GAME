; Godot 4.7.2 — shared configuration, no machine-specific paths.
config_version=5

[application]
config/name="Junior Astronaut · Misión Marte"
run/main_scene="res://scenes/menus/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=800
window/size/window_width_override=1152
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.035, 0.055, 0.09, 1)

[audio]
driver/enable_input=false
